manager:
  replicaCount: {{ aif_operator_replicas }}
{% if aif_operator_image_registry or aif_operator_image_repository or aif_operator_image_tag or aif_operator_image_pull_policy %}
  image:
{% if aif_operator_image_registry %}
    registry: {{ aif_operator_image_registry }}
{% endif %}
{% if aif_operator_image_repository %}
    repository: {{ aif_operator_image_repository }}
{% endif %}
{% if aif_operator_image_tag %}
    tag: {{ aif_operator_image_tag }}
{% endif %}
{% if aif_operator_image_pull_policy %}
    pullPolicy: {{ aif_operator_image_pull_policy }}
{% endif %}
{% endif %}
  resources:
    limits:
      cpu: {{ aif_operator_cpu_limits }}
      memory: {{ aif_operator_memory_limits }}
    requests:
      cpu: {{ aif_operator_cpu_requests }}
      memory: {{ aif_operator_memory_requests }}

{% set _creds = aif_credentials | dict2items | selectattr('value.username', 'defined') | rejectattr('value.username', 'equalto', '') | list %}
{% if _creds %}
credentials:
{% for _c in _creds %}
  {{ _c.key }}:
    username: {{ _c.value.username | to_json }}
    password: {{ _c.value.password | default('') | to_json }}
{% endfor %}
{% endif %}

metrics:
  enable: {{ aif_metrics_enabled | lower }}

aiExtension:
  enabled: {{ aif_extension_enabled | lower }}
{% set _ext_image = aif_extension_image_registry or aif_extension_image_repository or aif_extension_image_tag or aif_extension_image_pull_policy %}
{% set _ext_auth = aif_extension_registry_username | length > 0 %}
{% set _ext_tls = (aif_extension_registry_ca_cert | length > 0) or (aif_extension_client_tls_secret_name | length > 0) %}
{% if aif_extension_chart_url or aif_extension_chart_version or _ext_image or _ext_auth or _ext_tls %}
  source:
    helm:
{% if aif_extension_chart_url %}
      chartURL: {{ aif_extension_chart_url }}
{% endif %}
{% if aif_extension_chart_version %}
      version: {{ aif_extension_chart_version }}
{% endif %}
{% if _ext_auth %}
      auth:
        basic:
          userSecretRef: { name: {{ aif_extension_registry_secret_name }}, key: username }
          tokenSecretRef: { name: {{ aif_extension_registry_secret_name }}, key: password }
{% endif %}
{% if _ext_tls %}
      tls:
{% if aif_extension_registry_ca_cert | length > 0 %}
        caSecretRef: { name: {{ aif_extension_registry_ca_secret_name }}, key: ca.crt }
{% endif %}
{% if aif_extension_client_tls_secret_name | length > 0 %}
        clientTLSSecretRef: { name: {{ aif_extension_client_tls_secret_name }} }
{% endif %}
{% endif %}
{% if _ext_image %}
      values:
        image:
{% if aif_extension_image_registry %}
          registry: {{ aif_extension_image_registry }}
{% endif %}
{% if aif_extension_image_repository %}
          repository: {{ aif_extension_image_repository }}
{% endif %}
{% if aif_extension_image_tag %}
          tag: {{ aif_extension_image_tag }}
{% endif %}
{% if aif_extension_image_pull_policy %}
          pullPolicy: {{ aif_extension_image_pull_policy }}
{% endif %}
{% endif %}
{% endif %}
